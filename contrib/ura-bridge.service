# systemd *user* service. Install:
#   mkdir -p ~/.config/systemd/user
#   cp contrib/ura-bridge.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ura-bridge
#   sudo loginctl enable-linger $USER      # keep running after you log out
# Logs (the first-run setup code is printed here):
#   journalctl --user -u ura-bridge -f
[Unit]
Description=Ura Bridge
After=network-online.target

[Service]
WorkingDirectory=%h/ura/bridge
Environment=DATA_DIR=%h/ura/bridge/data
Environment=WEB_PORT=8080
ExecStart=%h/ura/venv/bin/python -u bridge.py
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
