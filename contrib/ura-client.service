# systemd *user* service. Install:
#   mkdir -p ~/.config/systemd/user
#   cp contrib/ura-client.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ura-client
#   sudo loginctl enable-linger $USER      # keep running after you log out
# Logs (the first-run setup code is printed here):
#   journalctl --user -u ura-client -f
[Unit]
Description=ura-mesh-client
After=network-online.target

[Service]
WorkingDirectory=%h/ura/client
Environment=DATA_DIR=%h/ura/client/data
Environment=WEB_PORT=8080
ExecStart=%h/ura/venv/bin/python -u client.py
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
