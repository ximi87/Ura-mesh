# systemd service for the Ura Hub (system-wide). Adjust User and paths, then:
#   sudo cp contrib/ura-hub.service /etc/systemd/system/ && sudo systemctl enable --now ura-hub
[Unit]
Description=Ura Hub
After=network-online.target

[Service]
User=ura
WorkingDirectory=/opt/ura/hub
Environment=DATA_DIR=/opt/ura/hub-data
Environment=WEB_PORT=8100
ExecStart=/opt/ura/venv/bin/python -u hub.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
